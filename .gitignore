# ---------------------------------------------------------------------------
# Build outputs — regenerated by the build scripts (build_slim.bat etc.).
# These are large and never committed; the installer goes to GitHub Releases.
# The scripts write to C:\TyperBuild by default; if you redirect them inside
# the repo, these rules keep the outputs out of git.
# ---------------------------------------------------------------------------
build/
build_slim/
dist/
dist_slim/
Output/
TyperBuild/
*.exe

# ---- Model weights (large; downloaded at build time or first run) ----
models/
models_slim/
*.safetensors
*.bin
*.pt

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- Virtual environments ----
venv/
venv_cpu/
.venv/
env/

# ---- Logs & scratch ----
*.log
*_log.txt
full_sizes.txt
typer_error.log

# ---- Per-user runtime state (written next to the app when it runs) ----
config.json
last_text.txt
typer.lock

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
